# Copy this file to .env.local and fill in real values.
# Everything here is optional — features degrade gracefully when missing.

# --- Draft date poll (Supabase) ---
# Without these, the draft date poll is unavailable. Keeper scenarios are always
# stored in localStorage on each device (private what-if planning).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard may label this "publishable" (new) or "anon" (legacy).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI features (Anthropic) ---
# Without this, the Advisor / Trade Evaluator / Rules Chat / Draft Recap
# routes return 503 with a setup hint. Server-side only — NEVER expose this
# to the browser (do not prefix with NEXT_PUBLIC_).
ANTHROPIC_API_KEY=dummy-key-for-dev

# --- Feature flags for the metered AI tools ---
# Keeper Advisor and Trade Evaluator bill per Anthropic request, so they stay
# hidden until switched on: nav link removed, page 404s, API route 404s. Set
# either to "true" (or "1") in .env.local while working on the feature, and
# leave both unset in production until the cost is understood.
NEXT_PUBLIC_ENABLE_ADVISOR=
NEXT_PUBLIC_ENABLE_TRADE_EVALUATOR=